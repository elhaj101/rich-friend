# ── Backend ──────────────────────────────────────────────────────────────────
# Base URL of the Django REST backend (server-side only — used by the Route
# Handler proxy in src/lib/server/backend.ts). Leave unset to use the built-in
# in-memory mock backend (demo mode, no persistence).
BACKEND_API_URL=http://127.0.0.1:8000

# ── Demo auth ─────────────────────────────────────────────────────────────────
# "true" (default): guest sessions + any-credential login (preview mode).
# Set to "false" for real auth. Must match the backend's DEMO_AUTH setting.
NEXT_PUBLIC_DEMO_AUTH=true

# ── Contact ──────────────────────────────────────────────────────────────────
# WhatsApp number for the concierge FAB (digits only, with country code).
NEXT_PUBLIC_WHATSAPP=
