# Copy to .env and fill in. Every value has a safe dev default in settings.py.

# ── Core ─────────────────────────────────────────────────────────────────────
# REQUIRED in production. Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres (recommended): postgres://USER:PASSWORD@HOST:5432/richfriend
# Leave empty to fall back to SQLite (backend/db.sqlite3) for quick local runs.
DATABASE_URL=postgres:///richfriend

# ── CORS / frontend ──────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API (the Next.js app).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Demo / seeding (parity with the frontend mock) ───────────────────────────
# DEMO_AUTH=true enables POST /api/auth/guest/ (anonymous seeded accounts) and
# lets login fall back to creating the account when the email is unknown.
# Set BOTH to false in production.
DEMO_AUTH=true
SEED_NEW_USERS=true

# ── Media storage (optional — Cloudflare R2 / S3) ────────────────────────────
# Leave empty to store uploads on local disk under backend/media/.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
